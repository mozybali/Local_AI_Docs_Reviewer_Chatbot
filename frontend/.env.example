# Tarayıcının API istekleri için taban adres.
# Varsayılan "/backend": istekler aynı origin üzerinden Next sunucusuna gider,
# next.config.js'teki rewrite kuralı FastAPI'ye iletir (tek origin/tek tünel,
# CORS gerekmez). Backend'e doğrudan erişmek isterseniz mutlak URL verin:
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/backend

# Rewrite proxy'sinin hedefi (sunucu tarafı, tarayıcıya sızmaz).
# Docker/VPS kurulumunda ör. http://backend:8000 yapılabilir.
BACKEND_INTERNAL_URL=http://localhost:8000
