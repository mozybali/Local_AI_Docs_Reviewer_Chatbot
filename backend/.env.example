# Environment: development | production
# In production the app refuses to start with placeholder secrets below and
# disables the OpenAPI /docs endpoints.
ENVIRONMENT=development

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx

# Database
DATABASE_URL=postgresql+psycopg://localdoc:localdoc@localhost:5432/localdoc_ai

# Authentication (JWT)
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=degistir_bu_degeri_uretimde
# Allowed values: HS256, HS384, HS512
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Brute-force protection (login counts only failed attempts per IP+email)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Initial admin user
DEFAULT_ADMIN_EMAIL=admin@localdoc.ai
DEFAULT_ADMIN_PASSWORD=degistir_beni

# Local LLM
LLM_PROVIDER=lmstudio
LLM_API_URL=http://localhost:1234/v1
LLM_MODEL_NAME=local-model
# Optional LLM generation params (defaults used if omitted)
LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS is the OUTPUT token limit (max_tokens), NOT the context
# window. The context window comes from LLM_CONTEXT_WINDOW (single default
# model) or from each entry in LLM_ALLOWED_MODELS. Do not mix these up.
LLM_MAX_TOKENS=1024
# Context window (total tokens) of the default model. The server enforces the
# context budget: input is trimmed to context_window - max_output_tokens - margin.
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT=120

# Model allowlist (JSON list). Users can only pick models defined here; the
# client sends only model_id — context_window / max_output_tokens / temperature
# are server-side only and never accepted from requests. If unset or empty, a
# single default model is built from LLM_MODEL_NAME / LLM_TEMPERATURE /
# LLM_MAX_TOKENS / LLM_CONTEXT_WINDOW above (backward compatible).
# modes: which chat screens the model may serve ("rag" and/or "general").
#LLM_ALLOWED_MODELS=[{"id":"local-model","label":"Local Model","context_window":8192,"max_output_tokens":1024,"temperature":0.2,"enabled":true,"modes":["rag","general"]}]

# Chat rate limit (per user + IP + mode within the sliding window)
CHAT_RATE_LIMIT_ATTEMPTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=300

# Vector store
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=localdoc_chunks

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=8
# Retrieval score threshold (cosine similarity, 1.0 = most similar). Matches
# below this are dropped before being sent to the LLM; raise it after measuring
# with evaluation/ to better reject irrelevant (negative) questions.
RETRIEVAL_MIN_SCORE=0.0

# Clients (CORS)
FRONTEND_ORIGIN=http://localhost:3000
